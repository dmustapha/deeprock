# Blockchain
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/
DEPLOYER_PRIVATE_KEY=
BSCSCAN_API_KEY=

# Contracts (populated after deployment)
# BIOMETRIC_REGISTRY_ADDRESS=0xE68ceD9a57168b2A7F889419345C43dFA89C38CC
# CREDENTIAL_VERIFIER_ADDRESS=
# RWA_GATEWAY_ADDRESS=
# DOCUMENT_SEAL_ADDRESS=
BIOMETRIC_REGISTRY_ADDRESS=
CREDENTIAL_VERIFIER_ADDRESS=
RWA_GATEWAY_ADDRESS=
DOCUMENT_SEAL_ADDRESS=

# RWA Investment Contracts (deploy with: cd contracts && npx hardhat run script/deploy.ts --network bscTestnet)
# MOCK_USDC_ADDRESS=0xf2943580DABc1dd5eD417a5DC58D35110640BB2f
# RWA_POOL_ADDRESS=0x5F6a3AbC97E421f7B3930fc504D6a0CE4eE41e06
MOCK_USDC_ADDRESS=
RWA_POOL_ADDRESS=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rwa_gateway

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-256-bit-secret-here
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RWA Gateway
WEBAUTHN_ORIGIN=http://localhost:3000

# Relayer (for gasless on-chain biometric registration)
# Generate new wallet: node -e "const {Wallet}=require('ethers'); const w=Wallet.createRandom(); console.log('RELAYER_PRIVATE_KEY='+w.privateKey+'\nRELAYER_ADDRESS='+w.address)"
# Fund with testnet BNB: https://testnet.bnbchain.org/faucet-smart (minimum 0.5 BNB recommended)
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=

# Chain ID (97=BSC testnet, 56=BSC Mainnet)
CHAIN_ID=97

# ERC-4337 Account Abstraction (deployed to BSC Testnet)
# RWA_PAYMASTER_ADDRESS=0xfD46dE36745402238826672af2132e59f1caDbBA
# P256_WALLET_FACTORY_ADDRESS=0x6AcCCB4DE7F9Ab442e3d50DFd7a62672E6264b86
RWA_PAYMASTER_ADDRESS=
P256_WALLET_FACTORY_ADDRESS=

# Monitoring & Alerting
ENABLE_MONITORING=true
MONITORING_INTERVAL_MS=300000
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
RELAYER_LOW_BALANCE_BNB=0.5
PAYMASTER_LOW_DEPOSIT_BNB=0.1
